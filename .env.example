# Supabase — copie para .env e preencha (nunca commitar .env)
# Dashboard: https://supabase.com/dashboard/project/<project-ref>/settings/api

VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Apenas Edge Functions / scripts server-side — NUNCA no frontend (sem prefixo VITE_)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# E-mail convite matrícula (secrets no Supabase — não commitar)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=RingPro <onboarding@resend.dev>
# APP_PUBLIC_URL=http://localhost:5173

# Senha do Postgres (Dashboard → Settings → Database) — só para scripts locais (apply-db-remote.mjs)
# SUPABASE_DB_PASSWORD=sua_senha_do_banco
# Opcional: connection string completa (Settings → Database → Connection string → URI)
# SUPABASE_DB_URL=postgresql://postgres:...@db.SEU_REF.supabase.co:5432/postgres
